# ============================================================
# REVERS Messenger — переменные окружения
# ============================================================
# Скопируй этот файл в .env и заполни значения.
#   cp .env.example .env
# ============================================================

# --- Сервер ---

# Порт, на котором слушает Node.js.
# Render автоматически подставляет свой PORT — локально можно 3000.
PORT=3000

# --- Turso (база данных) ---
# Получить: https://turso.tech → создать базу → turso db show <name> --url
# Токен:    turso db tokens create <name>

TURSO_URL=libsql://your-database-name.turso.io
TURSO_TOKEN=your-turso-auth-token-here

# --- JWT ---
# Секрет для подписи токенов. Минимум 64 случайных символа.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET=change-me-to-a-random-64-character-string

# --- CORS ---
# Через запятую. Для локальной разработки — localhost.
# Для продакшена — домен клиента (GitHub Pages или свой).
# Пример: https://username.github.io,https://revers.example.com

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
